{
  "manifest_version": 3,
  "name": "RDEX Dashboard",
  "version": "1.0.0",
  "description": "A minimalist new tab dashboard with modern UI",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "RDEX Dashboard"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.quotable.io/*"
  ],
  "commands": {
    "save-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current tab to RDEX"
    }
  },
  "background": {
    "service_worker": "src/js/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.quotable.io;"
  }
}
