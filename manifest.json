{
  "manifest_version": 3,
  "name": "RDEX Dashboard",
  "version": "1.0.0",
  "description": "A minimal new tab dashboard with clock, quotes, focus tracking, and link management",
  "author": "RDEX Dashboard Contributors",
  "permissions": [
    "storage",
    "tabs", 
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.quotable.io/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.quotable.io/;"
  },
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "commands": {
    "save-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current tab to Links"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rdex-dashboard@example.com",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": ["src/js/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "exclude_matches": ["*://*/src/index.html"],
      "js": ["src/js/content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "action": {
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_title": "Save Current Page to RDEX"
  }
}
